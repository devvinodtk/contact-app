<!DOCTYPE html>
<html>
  <head>
     <meta charset="utf-8">
    <title>Members Phone Number List</title>
    <style>
      body {
        font-family: sans-serif;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      thead {
        background-color: rgb(243, 244, 246);
      }
      th, td {
        border: 1px solid black;
        padding: 8px;
        text-align: left;
      }
      th {
        background: #f0f0f0;
      }
    </style>
  </head>
  <body>
    <h4>Kalakairali Members Contact Number List.</h4>
    <h5>Generated on <%= generatedOn %></h5>
    <table>
      <thead>
        <tr>
          <th>Sl. No.</th>
          <th>Name</th>
          <th>Mobile</th>
          <th>Area</th>
        </tr>
      </thead>
      <tbody>
        <% members.forEach((member, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= member.personalDetails.name %></td>
            <td>+91 - <%= member.personalDetails.mobileNumber %></td>
            <td><%= member.presentAddress.postOffice %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </body>
</html>